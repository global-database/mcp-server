{
  "name": "global-database-mcp",
  "displayName": "Global Database",
  "description": "Company profiles, financials, ownership and KYB lookups from official government registries, as an MCP server for agent mode.",
  "version": "0.2.1",
  "publisher": "global-database",
  "license": "MIT",
  "icon": "logo.png",
  "homepage": "https://mcp.globaldatabase.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/global-database/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/global-database/mcp-server/issues"
  },
  "categories": ["AI", "Data Science", "Other"],
  "keywords": ["mcp", "company-data", "kyb", "compliance", "enrichment"],
  "engines": {
    "vscode": "^1.101.0"
  },
  "activationEvents": [
    "onMcpCollection:globalDatabaseProvider"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "globalDatabaseProvider",
        "label": "Global Database"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "typescript": "^5.6.0"
  }
}
